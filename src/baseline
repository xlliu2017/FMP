###############################################################################
#             OPTIONAL: ADVANCED REWIRING (SAME AS BEFORE)                    #
###############################################################################
def advanced_rewire(data, steps=2, dist_threshold=0.4):
    """
    Simple iterative approach removing edges with feature distance> threshold
    for heterophilous graphs.
    """
    x = data.x.cpu()
    eidx = data.edge_index.cpu()
    row, col = eidx
    for _ in range(steps):
        dist = torch.norm(x[row] - x[col], dim=1)
        keep_mask = (dist<dist_threshold)
        row, col = row[keep_mask], col[keep_mask]
    new_ei = torch.stack([row,col],dim=0).long()
    new_ei = coalesce(new_ei)
    data.edge_index = new_ei.to(data.x.device)
    return data


###############################################################################
#    GPRGNN Model: polynomial aggregator + standard MLP (two-layers)          #
###############################################################################
class GPRGNN(nn.Module):
    """
    A simplified GPRGNN approach:
      - We define a "K" for adjacency powers
      - We learn alpha_k for k=0..K
      - We do X_out = sum_{k=0..K} alpha_k * (A^k * X_in)
        then pass that through an MLP for final classification.

    We also keep a 2-layer MLP at the front (like "Pre-MLP -> GPR -> Post-MLP"),
    or we can do "X_in -> GPR aggregator -> final linear."

    For heterophily, typically larger K helps handle multi-hop relationships.

    Paper: "Adaptive Universal Generalized PageRank Graph Neural Network" (Chien et al., ICLR 2021).
    """
    def __init__(self, in_dim, hidden_dim, out_dim,
                 K=5, alpha_init=None, dropout=0.5, alpha_requires_grad=True):
        super().__init__()
        self.K = K
        # Learnable alpha_k
        if alpha_init is None:
            alpha_init = [1/(K+1)]*(K+1)  # uniform init
        self.alpha = nn.Parameter(torch.tensor(alpha_init, dtype=torch.float32),
                                  requires_grad=alpha_requires_grad)
        
        # MLP: We do a 2-layer or so
        self.mlp_pre = nn.Sequential(
            nn.Linear(in_dim, hidden_dim),
            nn.ReLU(),
            nn.Dropout(dropout),
            nn.Linear(hidden_dim, hidden_dim),
            nn.ReLU()
        )
        self.mlp_post = nn.Linear(hidden_dim, out_dim)

        self.dropout = nn.Dropout(dropout)

    def forward(self, x, A_list):
        """
        x: [N, in_dim]
        A_list: list of A^k * x, i.e. precomputed adjacency powers times x
                or we can do it on the fly. But let's do precompute for efficiency.

        Typically, we do:
          X_out = sum_{k=0..K} alpha_k * A^k x_mlp
        Then pass X_out -> final linear -> logsoftmax
        """
        # Pre-MLP
        x_mlp = self.mlp_pre(x)  # shape [N, hidden_dim]

        # aggregator
        # A_list is length K+1, each [N, hidden_dim]
        # if we do on the fly, we'd do e.g. repeated spmm, but let's do precompute
        # for k in range(K+1), alpha_k * A^k x_mlp
        out_sum = 0
        for k in range(self.K+1):
            out_sum += self.alpha[k]*A_list[k]

        # post
        logits = self.mlp_post(out_sum)
        return F.log_softmax(logits, dim=1)


###############################################################################
#          Precompute A^k x_in for k=0..K with adjacency from data            #
###############################################################################
def precompute_adj_powers(data, K, device):
    """
    We'll build a normalized adjacency and compute [I, A, A^2, ..., A^K] * X_mlp
    But if we do a pre-MLP, it's easier to do repeated spmm after MLP. 
    Instead, we can do this inside forward, but let's do a function that helps.

    For "chameleon," large graphs might be slow. We'll do on-the-fly repeated spmm:
        A^0 x_mlp = x_mlp
        A^1 x_mlp = spmm(A, x_mlp)
        ...
    We'll do it in forward. So let's skip precompute?

    Alternatively, we store adjacency in a torch sparse, do repeated spmm. We'll do that in forward. 
    But for GPR we want to do repeated spmm on the hidden MLP output each time. 
    We'll do the single adjacency matrix A in "build_norm_adj" and then do repeated spmm inside forward.

    So let's define "build_norm_adj," returning "A_sp." We'll do repeated powers in forward. 
    We'll define a small helper "adj_pow_k(A_sp, X, k)."

    We'll proceed. 
    """
    pass


def build_norm_adj(data, add_self_loop=True):
    """
    Build row-normalized adjacency from data.edge_index, for example.
    Then store as torch.sparse. We'll do repeated spmm for powers.
    """
    from torch_geometric.utils import coalesce
    eidx = data.edge_index
    row, col = eidx
    # optionally add self loops
    if add_self_loop:
        eidx, _ = remove_self_loops(eidx)
        eidx, _ = add_self_loops(eidx, num_nodes=data.num_nodes)
        row, col = eidx
    
    # build adjacency in coo
    val = torch.ones(row.shape[0], dtype=torch.float32, device=row.device)
    # compute degrees
    deg = torch.zeros(data.num_nodes, device=row.device)
    deg = deg.index_add_(0, row, val)  # sum up degrees
    deg_inv = 1.0/(deg+1e-12)

    # build
    val_norm = deg_inv[row]
    indices = torch.stack([row, col], dim=0)
    A_sp = torch.sparse_coo_tensor(indices, val_norm, (data.num_nodes, data.num_nodes)).coalesce()
    return A_sp


def spmm_power(A_sp, X, k):
    """
    Repeated spmm to get A^k X. We'll do repeated calls or a quick loop.
    """
    out = X
    for _ in range(k):
        out = torch.sparse.mm(A_sp, out)
    return out


###############################################################################
#                         TRAINING SCRIPT WITH GPRGNN                         #
###############################################################################
def run_demo_gprgnn(dataset_name='chameleon',
                    K=5,
                    hidden_dim=64,
                    alpha_init=None,
                    dropout=0.5,
                    lr=0.005,
                    weight_decay=1e-3,
                    epochs=300,
                    advanced_rewire_flag=False,
                    device='cuda'):
    """
    Implementation of a GPRGNN-like model for the same setting as prior examples.

    If dataset_name in [chameleon, squirrel], we load WikipediaNetwork.
    Otherwise, we load Planetoid for [Cora, CiteSeer, Pubmed].
    We also do optional rewiring, same training style, etc.
    """
    import torch
    from torch_geometric.utils import coalesce
    from torch_geometric.transforms import NormalizeFeatures

    ds_lower = dataset_name.lower()
    if ds_lower in ['cora','citeseer','pubmed']:
        path = osp.join('./data', ds_lower)
        dataset = Planetoid(root=path, name=dataset_name, transform=NormalizeFeatures())
        data = dataset[0]
    elif ds_lower in ['chameleon','squirrel']:
        path = osp.join('./data', ds_lower)
        dataset = WikipediaNetwork(root=path, name=ds_lower, transform=NormalizeFeatures())
        data = dataset[0]
        data.train_mask = data.train_mask[:,0].bool()
        data.val_mask   = data.val_mask[:,0].bool()
        data.test_mask  = data.test_mask[:,0].bool()
    else:
        raise ValueError(f"Unknown dataset {dataset_name}")

    device = torch.device(device if torch.cuda.is_available() else 'cpu')
    data = data.to(device)

    # rewiring if desired
    if advanced_rewire_flag:
        data = advanced_rewire(data, steps=2, dist_threshold=0.4)

    # Build row-normalized adjacency
    A_sp = build_norm_adj(data, add_self_loop=True)  # shape [N,N], row-normalized

    # Build model
    model = GPRGNN(in_dim=dataset.num_features,
                   hidden_dim=hidden_dim,
                   out_dim=dataset.num_classes,
                   K=K,
                   alpha_init=alpha_init,
                   dropout=dropout).to(device)

    optimizer = torch.optim.Adam(model.parameters(), lr=lr, weight_decay=weight_decay)

    # We do repeated spmm in forward? Let's do that:
    # We'll define a helper: compute A^k x_mlp on the fly. 
    # We'll store them in forward. 
    # Actually, let's just do it in forward because we need x after MLP. 
    # So let's keep the training loop standard:

    # train
    best_val, best_test = 0.,0.
    best_state = None
    patience, max_patience = 0, 50

    for epoch in range(epochs):
        model.train()
        optimizer.zero_grad()

        # forward
        # 1) pre-MLP: x_mlp = model.mlp_pre(x)
        # 2) for k=0..K => A^k x_mlp
        x_mlp = model.mlp_pre(data.x)
        A_list = []
        # A^0 x_mlp = x_mlp
        A_list.append(x_mlp)
        out_k = x_mlp
        for kpow in range(1, K+1):
            out_k = torch.sparse.mm(A_sp, out_k)  # A^k
            A_list.append(out_k)
        # aggregator
        sum_agg = 0
        for k in range(K+1):
            sum_agg += model.alpha[k]*A_list[k]
        logits = model.mlp_post(sum_agg)
        out = F.log_softmax(logits, dim=1)

        loss = F.nll_loss(out[data.train_mask], data.y[data.train_mask])
        loss.backward()
        optimizer.step()

        model.eval()
        with torch.no_grad():
            x_mlp_eval = model.mlp_pre(data.x)
            A_list_eval = [x_mlp_eval]
            tmp_k = x_mlp_eval
            for kpow in range(1, K+1):
                tmp_k = torch.sparse.mm(A_sp, tmp_k)
                A_list_eval.append(tmp_k)
            sum_eval = 0
            for k in range(K+1):
                sum_eval += model.alpha[k]*A_list_eval[k]
            logits_eval = model.mlp_post(sum_eval)
            out_eval = F.log_softmax(logits_eval, dim=1)

        def accuracy(mask):
            p = out_eval[mask].max(dim=1)[1]
            return (p==data.y[mask]).sum().item()/mask.sum().item()

        train_acc = accuracy(data.train_mask)
        val_acc   = accuracy(data.val_mask)
        test_acc  = accuracy(data.test_mask)

        if val_acc>best_val:
            best_val = val_acc
            best_test= test_acc
            best_state = model.state_dict().copy()
            patience=0
        else:
            patience+=1

        if epoch%20==0:
            print(f"Epoch {epoch:03d} | loss={loss.item():.4f} "
                  f"train={train_acc:.2f} val={val_acc:.2f} test={test_acc:.2f} pat={patience}")

        if patience>max_patience:
            print("Early stop!")
            break

    if best_state:
        model.load_state_dict(best_state)
    print(f"\n>>> GPRGNN final best val={best_val:.4f}, test={best_test:.4f}\n")


